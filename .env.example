# Copy to .env in the project root. Restart `npm run dev` after changes.

# Either line works; the Vite dev server proxy reads both (avoids browser CORS).
GEMINI_API_KEY=your_gemini_api_key_here
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

VITE_GEMINI_MODEL=gemini-2.5-flash

# Only if a corporate proxy breaks TLS verification (avoid when possible):
# GEMINI_PROXY_TLS_INSECURE=true

# Only if your host proxies /api/gemini to Google:
# VITE_GEMINI_USE_PROXY=true
